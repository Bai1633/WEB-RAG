# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=dev
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=web_rag
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# JWT Auth Configuration
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration
# Provider: openai, ollama, compatible
# 阿里云百炼(DashScope) 走 OpenAI 兼容模式：provider 保持 openai/compatible，base_url 指向百炼兼容端点
LLM_PROVIDER=openai
LLM_MODEL_NAME=qwen-plus        # ← 自行替换：qwen-turbo / qwen-plus / qwen-max 等
LLM_API_KEY=your-dashscope-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# For Ollama: LLM_BASE_URL=http://localhost:11434

# Embedding Configuration
# Provider: openai, huggingface
# 百炼 embedding 同样走 OpenAI 兼容模式
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-v3   # ← 自行替换：百炼 embedding 模型名
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024          # text-embedding-v3 默认 1024；换 embedding 模型需同步修改此处
EMBEDDING_BATCH_SIZE=32
# For HuggingFace local: EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=10
RERANK_TOP_N=5
RERANK_MODEL_NAME=bge-reranker-v2-m3
CONFIDENCE_THRESHOLD=0.35

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown,text/html,text/plain,text/csv

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Trust X-Forwarded-For for client IP (rate limiting). Enable ONLY behind a trusted
# reverse proxy (e.g. the bundled nginx); leave false when exposing the API directly.
TRUST_PROXY_HEADERS=false

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=3900


