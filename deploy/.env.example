# ============================================================
# web_rag 生产部署环境变量模板
#
# 用法：
#   cp .env.example .env     然后按注释填写真实值
#
# ⚠️ 安全红线：
#   1. .env 必须加入 .gitignore，绝不提交到仓库
#   2. JWT_SECRET_KEY 必须重新生成，禁止使用 change-me-in-production
#   3. 生成方式：openssl rand -hex 32    （或 PowerShell 见下方）
# ============================================================

# ------------------------------------------------------------
# 数据库（postgres 容器）
# ------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=请改成强密码
DB_NAME=web_rag

# ------------------------------------------------------------
# 认证密钥（最高优先级，必须修改）
# ------------------------------------------------------------
# PowerShell 生成：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET_KEY=请填入64位随机字符串

# ------------------------------------------------------------
# LLM 配置（方案 A：阿里云 DashScope / 通义千问）← 当前项目在用
# ------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=qwen3.7-flash-2026-07-15
LLM_API_KEY=sk-你的DashScope密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------
# Embedding 配置（必须与 LLM 同一家或自建）
# ------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding
EMBEDDING_API_KEY=sk-你的DashScope密钥
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠️ 维度必须与模型实际输出一致，否则向量列长度不匹配、入库即失败：
#    text-embedding-ada-002 = 1536
#    qwen3.7-text-embedding = 1024（本项目默认，可自定义 256~2560）
EMBEDDING_DIM=1024

# ------------------------------------------------------------
# 重排序（Reranker）
# ------------------------------------------------------------
# 默认 false：backend 镜像未打包 models/ 权重，开启会加载失败并静默降级，
# 却白白装了 3GB 的 torch。若要开启，需先把权重挂进容器并设为 true。
# 参见 部署与启动手册.md 的「可选：启用重排」一节。
RERANK_ENABLED=false

# ------------------------------------------------------------
# CORS 允许的来源（最容易踩的坑）
# ------------------------------------------------------------
# 必须填浏览器实际访问的地址（含协议+主机+端口，不带路径，多个用逗号分隔）。
# 用 IP 访问就写 IP；用域名访问就写域名。写成 localhost 而实际用 IP 打开
# 会直接跨域失败，且现象和"后端挂了"一模一样。
# 例：
#   CORS_ORIGINS=http://192.168.1.100
#   CORS_ORIGINS=http://your-domain.com,https://your-domain.com
CORS_ORIGINS=http://localhost

# ------------------------------------------------------------
# （可选）方案 B：改用 OpenAI 官方
# ------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-3.5-turbo
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-ada-002
# EMBEDDING_DIM=1536
