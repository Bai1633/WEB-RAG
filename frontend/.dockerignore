# ============================================================
# Docker build context exclusions for frontend
# ============================================================

# --- Dependencies & build output (rebuilt inside the image) ---
node_modules/
dist/
.npm/
.pnpm-store/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Tooling / VCS / IDE ---
.git/
.gitignore
.github/
.idea/
.vscode/
*.swp
.DS_Store

# --- Tests & docs ---
coverage/
*.md
